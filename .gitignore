# GNAT/GPRbuild output
obj/
lib/
/*.ali
/*.o

# Alire/local tool state
alire/
.alire/

# Alire-generated crate config. All of it: Alire writes messages_config.ads
# and .h beside the .gpr and rewrites them at every build, with the profile of
# that build in them -- so tracking them made this crate dirty after any build
# that was not the last one committed, which is what a path-pinned release
# cannot have. Every sibling crate ignores /config/ for this reason.
/config/

# Bundled i18n locale data (generated by i18n's regeneration chain, copied in
# beside a test or example binary as Exe/../share/i18n). CI populates it for
# tests, conformance, examples and benchmarks; it is never edited here.
*/share/i18n/

/tools/catalog_check/alire/
/tools/catalog_check/config/
/tools/catalog_check/obj/
/tools/catalog_check/bin/
